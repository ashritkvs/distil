# --- Optional LLM (quality=true) compression path ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Connector auth: gate /mcp with this key (leave empty to disable) ---
CONNECTOR_API_KEY=

# --- Aggregate metrics store (serverless). If unset, a local JSON file is used ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Transport security (defaults rely on the API key) ---
TF_DNS_REBIND_PROTECTION=false
TF_ALLOWED_HOSTS=*
TF_ALLOWED_ORIGINS=*
